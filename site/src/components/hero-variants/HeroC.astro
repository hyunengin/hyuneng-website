---
/** 시안 C: 투톤 분할. 왼쪽 연한 하늘빛 바탕 + 남색 제목, 오른쪽 밝은 파랑 패널에 흰 선 일러스트(건물·크레인) */
import Icon from '../Icon.astro';
import company from '../../data/company.json';
---

<section class="hv hv-c">
  <div class="hv-bg" aria-hidden="true">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="hvc-p" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#3676B7"></stop>
          <stop offset="1" stop-color="#63A4E3"></stop>
        </linearGradient>
        <pattern id="hvc-grid" width="60" height="60" patternUnits="userSpaceOnUse">
          <path d="M60 0H0V60" fill="none" stroke="#fff" stroke-opacity="0.14"></path>
        </pattern>
      </defs>
      <rect width="1600" height="900" fill="#F3F8FD"></rect>
      <circle cx="140" cy="840" r="320" fill="#E4EEF9"></circle>
      <polygon points="900,0 1600,0 1600,900 720,900" fill="url(#hvc-p)"></polygon>
      <polygon points="900,0 1600,0 1600,900 720,900" fill="url(#hvc-grid)"></polygon>
      <g fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="960" y="470" width="130" height="430" stroke-opacity="0.9"></rect>
        <rect x="1130" y="330" width="170" height="570" stroke-opacity="0.95"></rect>
        <rect x="1340" y="420" width="120" height="480" stroke-opacity="0.9"></rect>
        <rect x="1500" y="260" width="170" height="640" stroke-opacity="0.85"></rect>
        <path d="M990 520h70M990 570h70M990 620h70M990 670h70M990 720h70M990 770h70" stroke-opacity="0.55"></path>
        <path d="M1160 380h110M1160 440h110M1160 500h110M1160 560h110M1160 620h110M1160 680h110M1160 740h110M1160 800h110" stroke-opacity="0.55"></path>
        <path d="M1370 470h60M1370 530h60M1370 590h60M1370 650h60M1370 710h60M1370 770h60" stroke-opacity="0.55"></path>
        <path d="M1530 310h110M1530 380h110M1530 450h110M1530 520h110M1530 590h110M1530 660h110M1530 730h110" stroke-opacity="0.55"></path>
        <path d="M1215 330V110M1215 110H1500M1215 110L1180 150M1500 110L1460 150M1440 110V190M1425 190h30v26h-30z" stroke-opacity="0.95"></path>
        <path d="M1215 160L1260 110M1215 210L1300 110M1215 260L1340 110" stroke-opacity="0.6"></path>
        <path d="M720 900H1600" stroke-opacity="0.9" stroke-width="3"></path>
      </g>
      <g fill="#fff" fill-opacity="0.35">
        <circle cx="1040" cy="150" r="60"></circle>
      </g>
    </svg>
  </div>
  <div class="container hv-content">
    <p class="hv-eyebrow">{company.nameEn}</p>
    <h2 class="hv-title">정확한 판단,<br />안전한 구조,<br />신뢰받는 기술</h2>
    <p class="hv-desc">
      안전진단 · 법원감정 · 원가계산 · 건축·토목 구조검토<br />
      건설 분야 전반의 기술적·법률적 서비스를 수행하는 구조안전 전문기업
    </p>
    <div class="hv-ctas">
      <a class="btn btn-blue" href="/business/safety-diagnosis">사업분야 보기 <Icon name="arrow" size={18} /></a>
      <a class="btn btn-outline" href="/inquiry">견적문의 <Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>

<style>
  .hv-c {
    background: #f3f8fd;
    color: var(--ink);
  }
  .hv-c .hv-eyebrow {
    color: var(--blue);
  }
  .hv-c .hv-title {
    color: var(--navy);
  }
  .hv-c .hv-desc {
    color: var(--ink-2);
  }
  .hv-c .hv-content > * {
    max-width: 560px;
  }
  @media (max-width: 1024px) {
    .hv-c .hv-bg {
      display: none;
    }
    .hv-c::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 120px;
      background: linear-gradient(100deg, #3676b7, #63a4e3);
      clip-path: polygon(0 40%, 100% 0, 100% 100%, 0 100%);
    }
    .hv-c .hv-content {
      padding-bottom: 180px;
    }
  }
</style>
