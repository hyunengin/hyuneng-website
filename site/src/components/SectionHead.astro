---
interface Props {
  eyebrow?: string;
  title: string;
  desc?: string;
  center?: boolean;
}
const { eyebrow, title, desc, center = false } = Astro.props;
---

<div class:list={['section-head', { center }]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2>{title}</h2>
  {desc && <p>{desc}</p>}
</div>
