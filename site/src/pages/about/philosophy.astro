---
import SubLayout from '../../layouts/SubLayout.astro';
import Icon from '../../components/Icon.astro';

const values = [
  {
    icon: 'shield',
    name: '안전성',
    en: 'SAFETY',
    desc: '구조적 안정과 시공의 합리성 확보',
  },
  {
    icon: 'search',
    name: '정확성',
    en: 'ACCURACY',
    desc: '근거와 데이터를 기반으로 한 객관적 판단',
  },
  {
    icon: 'award',
    name: '신뢰성',
    en: 'RELIABILITY',
    desc: '투명하고 공정한 업무 수행으로 신뢰 확보',
  },
];
---

<SubLayout title="기업이념" section="about" description="현구조안전공사가 일하는 기준입니다.">
  <section class="vision">
    <span class="eyebrow">VISION</span>
    <p class="vision-headline">건설기술감정 및 정밀안전진단 분야의 절대적 표준이 되는 기업</p>
    <p class="vision-text">
      ㈜현구조안전공사는 축적된 공학적 데이터와 융합형 기술 역량을 바탕으로 건설 엔지니어링 시장의 혁신을
      주도하고, 정확한 분석과 책임 있는 기술 서비스를 통해 공정하고 안전한 건설환경 조성에 앞장서겠습니다.
    </p>
  </section>

  <section class="content-block">
    <h3 class="block-title">핵심 가치</h3>
    <div class="values">
      {
        values.map((v, i) => (
          <div class="value-card">
            <span class="value-no">0{i + 1}</span>
            <span class="icon-circle">
              <Icon name={v.icon} size={26} />
            </span>
            <span class="value-en">{v.en}</span>
            <h4>{v.name}</h4>
            <p>{v.desc}</p>
          </div>
        ))
      }
    </div>
  </section>
</SubLayout>

<style>
  .vision {
    padding: 44px 48px;
    border-radius: var(--radius);
    background: linear-gradient(130deg, var(--navy-deep), var(--navy) 60%, #1a4f96);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .vision::after {
    content: '';
    position: absolute;
    right: -80px;
    top: -80px;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .vision .eyebrow {
    color: var(--blue-pale);
  }
  .vision-headline {
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: #fff;
    margin-bottom: 18px;
    max-width: 760px;
  }
  .vision-text {
    font-size: clamp(16px, 1.5vw, 18.5px);
    line-height: 1.75;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.88);
    max-width: 760px;
  }
  .values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .value-card {
    position: relative;
    padding: 32px 28px 30px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fff;
  }
  .value-no {
    position: absolute;
    right: 24px;
    top: 20px;
    font-size: 36px;
    font-weight: 800;
    color: var(--blue-tint);
    letter-spacing: -0.03em;
  }
  .value-en {
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--blue);
    font-weight: 700;
  }
  .value-card h4 {
    font-size: 22px;
    color: var(--navy);
    margin-top: -6px;
  }
  .value-card p {
    color: var(--ink-2);
  }
  @media (max-width: 768px) {
    .vision {
      padding: 32px 24px;
    }
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
