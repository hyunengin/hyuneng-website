---
import SubLayout from '../../layouts/SubLayout.astro';
import Icon from '../../components/Icon.astro';
import licenses from '../../data/licenses.json';
import qualifications from '../../data/qualifications.json';
---

<SubLayout
  title="면허보유현황"
  section="about"
  description="업무 수행을 위한 등록·신고 및 특허 보유 현황입니다."
>
  <div class="doc-grid">
    {
      licenses.map((l) => (
        <div class="doc-card">
          <div class="doc-thumb">
            {l.image ? (
              <a href={l.image} target="_blank" rel="noopener" aria-label={`${l.name} 크게 보기`}>
                <img src={l.image} alt={l.name} loading="lazy" />
              </a>
            ) : (
              <span class="doc-placeholder">
                <Icon name="doc" size={40} />
                {l.name}
              </span>
            )}
          </div>
          <div class="doc-body">
            <h4>{l.name}</h4>
            {l.number && <p>{l.number}</p>}
            {l.issuer && <p>{l.issuer}</p>}
          </div>
        </div>
      ))
    }
  </div>

  <section class="content-block">
    <h3 class="block-title">보유 기술자격</h3>
    <div class="qual-grid">
      {
        qualifications.map((q) => (
          <div class="qual-card">
            <span class="icon-circle">
              <Icon name="award" size={24} />
            </span>
            <div>
              <b>{q.name}</b>
              <span>{q.holder} · {q.year}년 취득</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</SubLayout>

<style>
  .doc-thumb a {
    display: block;
    width: 100%;
    height: 100%;
  }
  .doc-thumb img {
    object-position: top;
  }
  .qual-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .qual-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }
  .qual-card .icon-circle {
    width: 48px;
    height: 48px;
    flex: none;
  }
  .qual-card b {
    display: block;
    font-size: 17px;
    color: var(--navy);
  }
  .qual-card span:last-child {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .qual-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
