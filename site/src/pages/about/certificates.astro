---
import SubLayout from '../../layouts/SubLayout.astro';
import Icon from '../../components/Icon.astro';
import certificates from '../../data/certificates.json';
---

<SubLayout title="인증서" section="about" description="기업 인증 및 경영 시스템 인증 현황입니다.">
  <div class="doc-grid">
    {
      certificates.map((c) => (
        <div class="doc-card">
          <div class="doc-thumb">
            {c.image ? (
              <a href={c.image} target="_blank" rel="noopener" aria-label={`${c.name} 크게 보기`}>
                <img src={c.image} alt={c.name} loading="lazy" />
              </a>
            ) : (
              <span class="doc-placeholder">
                <Icon name="award" size={40} />
                {c.name}
              </span>
            )}
          </div>
          <div class="doc-body">
            <h4>{c.name}</h4>
            {c.number && <p>{c.number}</p>}
          </div>
        </div>
      ))
    }
  </div>
</SubLayout>

<style>
  .doc-thumb a {
    display: block;
    width: 100%;
    height: 100%;
  }
  .doc-thumb img {
    object-position: top;
  }
</style>
