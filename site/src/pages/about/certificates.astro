---
import SubLayout from '../../layouts/SubLayout.astro';
import Icon from '../../components/Icon.astro';
import certificates from '../../data/certificates.json';
---

<SubLayout title="인증서" section="about" description="경영 시스템 및 기업 인증 현황입니다.">
  <div class="doc-grid">
    {
      certificates.map((c) => (
        <div class="doc-card">
          <div class="doc-thumb">
            {c.image ? (
              <img src={c.image} alt={c.name} loading="lazy" />
            ) : (
              <span class="doc-placeholder">
                <Icon name="award" size={40} />
                {c.name}
              </span>
            )}
          </div>
          <div class="doc-body">
            <h4>{c.name}</h4>
            {c.number && <p>{c.number}</p>}
          </div>
        </div>
      ))
    }
  </div>
</SubLayout>
