---
import SubLayout from '../../layouts/SubLayout.astro';
import Icon from '../../components/Icon.astro';
import business from '../../data/business.json';
import company from '../../data/company.json';

export function getStaticPaths() {
  return business.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
type Business = (typeof business)[number];
const { b } = Astro.props as { b: Business };
---

<SubLayout title={b.title} section="business" description={b.headline}>
  <div class="biz-intro">
    <span class="icon-circle biz-icon">
      <Icon name={b.icon} size={30} />
    </span>
    <div class="prose">
      {b.intro.map((p) => <p>{p}</p>)}
    </div>
  </div>
  {b.legalNote && <p class="note">{b.legalNote}</p>}

  <section class="content-block">
    <h3 class="block-title">주요 업무</h3>
    <div class="service-grid">
      {
        b.services.map((s) => (
          <div class="service-card">
            <h4>{s.title}</h4>
            <p>{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="content-block">
    <h3 class="block-title">{b.targetsTitle}</h3>
    <ul class="checklist">
      {
        b.targets.map((t) => (
          <li>
            <Icon name="check" size={18} stroke={2.4} />
            <span>{t}</span>
          </li>
        ))
      }
    </ul>
    {b.targetsNote && <p class="note">{b.targetsNote}</p>}
  </section>

  <section class="content-block">
    <h3 class="block-title">수행 절차</h3>
    <ol class="process">
      {
        b.process.map((p, i) => (
          <li>
            <span class="step-no">0{i + 1}</span>
            <div>
              <h4>{p.title}</h4>
              <p>{p.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <aside class="biz-cta">
    <div>
      <span class="eyebrow">INQUIRY</span>
      <h3>{b.title} 업무 문의</h3>
      <p>현장 위치와 규모, 요청 업무를 알려주시면 검토 후 견적을 안내해 드립니다.</p>
    </div>
    <div class="biz-cta-actions">
      <a class="btn btn-light" href="/inquiry">온라인 견적문의 <Icon name="arrow" size={18} /></a>
      <a class="btn btn-outline-light" href={`tel:${company.tel}`}>
        <Icon name="phone" size={18} />
        {company.tel}
      </a>
    </div>
  </aside>
</SubLayout>

<style>
  .biz-intro {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .biz-icon {
    width: 56px;
    height: 56px;
  }
  .biz-cta {
    margin-top: 72px;
    padding: 40px 44px;
    border-radius: var(--radius);
    background: linear-gradient(130deg, var(--navy-deep), var(--navy) 60%, #1a4f96);
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .biz-cta .eyebrow {
    color: var(--blue-pale);
    margin-bottom: 8px;
  }
  .biz-cta h3 {
    color: #fff;
    font-size: 24px;
    margin-bottom: 8px;
  }
  .biz-cta p {
    color: rgba(255, 255, 255, 0.75);
  }
  .biz-cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {
    .biz-intro {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .biz-cta {
      padding: 28px 24px;
      margin-top: 48px;
    }
  }
</style>
