---
import SubLayout from '../../layouts/SubLayout.astro';
import Icon from '../../components/Icon.astro';
import business from '../../data/business.json';
import company from '../../data/company.json';

export function getStaticPaths() {
  return business.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}

// business.json 항목 중 선택 항목(principles, lawInfo, documents)은 분야에 따라 없을 수 있습니다.
interface Principle {
  icon: string;
  title: string;
  desc: string;
}
interface LawInfo {
  title: string;
  laws: { name: string; desc: string }[];
  facilityTitle: string;
  facilities: { grade: string; note: string; items: string[] }[];
  cycleTitle: string;
  cycleHead: string[];
  cycleRows: string[][];
  cycleNote: string;
  source: string;
}
interface Documents {
  title: string;
  items: string[];
  note: string;
}
type Business = (typeof business)[number] & {
  principles?: Principle[];
  lawInfo?: LawInfo;
  documents?: Documents;
};
const { b } = Astro.props as { b: Business };
---

<SubLayout title={b.title} section="business" description={b.headline}>
  <div class="biz-intro">
    <span class="icon-circle biz-icon">
      <Icon name={b.icon} size={30} />
    </span>
    <div class="prose">
      {b.intro.map((p) => <p>{p}</p>)}
    </div>
  </div>
  {b.legalNote && <p class="note">{b.legalNote}</p>}

  {
    b.principles && (
      <section class="content-block">
        <h3 class="block-title">수행 원칙</h3>
        <div class="principles">
          {b.principles.map((p, i) => (
            <div class="principle">
              <span class="icon-circle">
                <Icon name={p.icon} size={24} />
              </span>
              <div>
                <span class="principle-no">0{i + 1}</span>
                <b>{p.title}</b>
                <p>{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="content-block">
    <h3 class="block-title">주요 업무</h3>
    <div class="service-grid">
      {
        b.services.map((s) => (
          <div class="service-card">
            <h4>{s.title}</h4>
            <p>{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    b.lawInfo && (
      <section class="content-block">
        <h3 class="block-title">{b.lawInfo.title}</h3>
        <div class="law-grid">
          {b.lawInfo.laws.map((l) => (
            <div class="law-card">
              <h4>{l.name}</h4>
              <p>{l.desc}</p>
            </div>
          ))}
        </div>

        <h4 class="sub-title">{b.lawInfo.facilityTitle}</h4>
        <div class="table-wrap">
          <table class="table facility-table">
            <thead>
              <tr>
                <th scope="col">구분</th>
                <th scope="col">대상 건축물</th>
              </tr>
            </thead>
            <tbody>
              {b.lawInfo.facilities.map((f) => (
                <tr>
                  <th scope="row">
                    {f.grade}
                    {f.note && <small>{f.note}</small>}
                  </th>
                  <td>
                    <ul>
                      {f.items.map((it) => (
                        <li>{it}</li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h4 class="sub-title">{b.lawInfo.cycleTitle}</h4>
        <div class="table-wrap">
          <table class="table cycle-table">
            <thead>
              <tr>
                {b.lawInfo.cycleHead.map((h) => (
                  <th scope="col">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {b.lawInfo.cycleRows.map((row) => (
                <tr>
                  {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">{b.lawInfo.cycleNote}</p>
        <p class="law-source">{b.lawInfo.source}</p>
      </section>
    )
  }

  <section class="content-block">
    <h3 class="block-title">{b.targetsTitle}</h3>
    <ul class="checklist">
      {
        b.targets.map((t) => (
          <li>
            <Icon name="check" size={18} stroke={2.4} />
            <span>{t}</span>
          </li>
        ))
      }
    </ul>
    {b.targetsNote && <p class="note">{b.targetsNote}</p>}
  </section>

  <section class="content-block">
    <h3 class="block-title">수행 절차</h3>
    <ol class="process">
      {
        b.process.map((p, i) => (
          <li>
            <span class="step-no">0{i + 1}</span>
            <div>
              <h4>{p.title}</h4>
              <p>{p.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    b.documents && (
      <section class="content-block">
        <h3 class="block-title">{b.documents.title}</h3>
        <ul class="checklist docs-list">
          {b.documents.items.map((d) => (
            <li>
              <Icon name="doc" size={18} />
              <span>{d}</span>
            </li>
          ))}
        </ul>
        {b.documents.note && <p class="note">{b.documents.note}</p>}
      </section>
    )
  }

  <aside class="biz-cta">
    <div>
      <span class="eyebrow">INQUIRY</span>
      <h3>{b.title} 업무 문의</h3>
      <p>현장 위치와 규모, 요청 업무를 알려주시면 검토 후 견적을 안내해 드립니다.</p>
    </div>
    <div class="biz-cta-actions">
      <a class="btn btn-light" href="/inquiry">온라인 견적문의 <Icon name="arrow" size={18} /></a>
      <a class="btn btn-outline-light" href={`tel:${company.tel}`}>
        <Icon name="phone" size={18} />
        {company.tel}
      </a>
    </div>
  </aside>
</SubLayout>

<style>
  .biz-intro {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .biz-icon {
    width: 56px;
    height: 56px;
  }

  /* 수행 원칙 */
  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .principle {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 24px 22px;
    border-radius: var(--radius);
    background: var(--blue-tint);
    border: 1px solid var(--blue-line);
  }
  .principle .icon-circle {
    width: 48px;
    height: 48px;
    flex: none;
    background: #fff;
  }
  .principle-no {
    display: block;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--blue);
    margin-bottom: 4px;
  }
  .principle b {
    display: block;
    font-size: 18px;
    color: var(--navy);
    margin-bottom: 6px;
  }
  .principle p {
    font-size: 15px;
    color: var(--ink-2);
  }

  /* 법령 */
  .law-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .law-card {
    padding: 22px 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }
  .law-card h4 {
    font-size: 16.5px;
    color: var(--navy);
    margin-bottom: 10px;
    line-height: 1.4;
  }
  .law-card p {
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .sub-title {
    font-size: 17px;
    color: var(--ink);
    margin: 36px 0 14px;
  }
  .facility-table th[scope='row'] {
    background: var(--bg-2);
    color: var(--navy);
    white-space: nowrap;
    width: 160px;
    vertical-align: top;
  }
  .facility-table th small {
    display: block;
    margin-top: 4px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted);
    white-space: normal;
  }
  .facility-table ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .facility-table li {
    position: relative;
    padding-left: 14px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .facility-table li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--blue);
  }
  .cycle-table th[scope='row'] {
    background: var(--bg-2);
    color: var(--navy);
    white-space: nowrap;
  }
  .cycle-table td {
    font-size: 15px;
  }
  .law-source {
    margin-top: 12px;
    font-size: 13px;
    color: var(--muted);
  }
  .docs-list svg {
    color: var(--navy);
  }

  .biz-cta {
    margin-top: 72px;
    padding: 40px 44px;
    border-radius: var(--radius);
    background: linear-gradient(130deg, var(--navy-deep), var(--navy) 60%, #1a4f96);
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .biz-cta .eyebrow {
    color: var(--blue-pale);
    margin-bottom: 8px;
  }
  .biz-cta h3 {
    color: #fff;
    font-size: 24px;
    margin-bottom: 8px;
  }
  .biz-cta p {
    color: rgba(255, 255, 255, 0.75);
  }
  .biz-cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  @media (max-width: 1024px) {
    .principles,
    .law-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 768px) {
    .biz-intro {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .biz-cta {
      padding: 28px 24px;
      margin-top: 48px;
    }
    .facility-table th[scope='row'] {
      width: 110px;
      white-space: normal;
    }
  }
</style>
